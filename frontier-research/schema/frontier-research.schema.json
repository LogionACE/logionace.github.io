{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logionace.org/schemas/frontier-research.schema.json",
  "title": "ACE Frontier Research",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "series",
    "title",
    "subtitle",
    "status",
    "publication_date",
    "evidence_cutoff",
    "research_status",
    "confidence",
    "authors",
    "version",
    "abstract",
    "sections",
    "figures",
    "prediction_ids",
    "references",
    "recommended_citation",
    "organizational_disclosure",
    "evidence_boundary",
    "corrections"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^AFR-[0-9]{4}-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "series": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "review", "published", "archived"]
    },
    "publication_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_cutoff": {
      "type": "string",
      "format": "date"
    },
    "research_status": {
      "enum": ["Emerging", "Developing", "Established", "Falsified"]
    },
    "confidence": {
      "enum": ["Low", "Moderate", "Moderate-High", "High"]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "$ref": "#/$defs/claim"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "figures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "prediction_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AFR-[0-9]{4}-[0-9]{3}-P[0-9]{2}$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 20,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "recommended_citation": {
      "type": "string",
      "minLength": 1
    },
    "organizational_disclosure": {
      "type": "string",
      "minLength": 1
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 1
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["text", "reference_ids"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "classification", "blocks"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "observed-evidence",
            "emerging-problem",
            "ace-hypothesis",
            "open-questions",
            "analysis"
          ]
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "figure": {
      "type": "object",
      "required": ["id", "title", "path", "alt"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "source_type",
        "publication_status",
        "checked_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "type": "string"
        },
        "publication_status": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
